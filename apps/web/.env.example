# Firebase web app config (copy from Firebase console -> Project settings -> General)
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Optional (commonly present)
# VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
# VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXX"

# Optional emulator overrides
VITE_FIREBASE_AUTH_EMULATOR_HOST="http://localhost:9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="localhost:8080"

VITE_FIREBASE_API_KEY="FAKE_API_KEY_FOR_LOCAL_DEVELOPMENT"
VITE_FIREBASE_AUTH_DOMAIN="cursor-q-dev.firebaseapp.local"
VITE_FIREBASE_PROJECT_ID="cursor-q-dev"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_APP_ID="FAKE_APP_ID_FOR_LOCAL_DEVELOPMENT"
VITE_FIREBASE_MEASUREMENT_ID=""

# Emulator hosts (used by apps/web/src/lib/firebase.ts)
VITE_FIREBASE_AUTH_EMULATOR_HOST="http://localhost:9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="localhost:8080"

# Vite dev default host for functions emulator calls
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST="localhost:5001"

