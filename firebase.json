{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "apps/functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "emulators": {
    "ui": {
      "enabled": false
    },
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5004
    }
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/v1/admin/hospitals",
        "function": "adminHospitals"
      },
      {
        "source": "/api/v1/admin/summary",
        "function": "adminGetSummaryForDate"
      },
      {
        "source": "/api/v1/admin/sessions",
        "function": "adminGetSessions"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

